---
import { Icon } from "astro-icon/components";

const references = [
    {
        href: "/index/CV FR.pdf",
        alt: "Click to download my CV",
        name: "hugeicons:file-user",
    },
    {
        href: "https://www.linkedin.com/in/minh-hoang-alexis-huynh-621b52222/",
        alt: "Click to visit my LinkedIn profile",
        name: "hugeicons:linkedin-01",
    },
    {
        href: "https://github.com/Almiinh",
        alt: "Click to visit my GitHub profile",
        name: "hugeicons:github-01",
    },
];

const { class: className = "" } = Astro.props;
---

<div class:list={className}>
    {
        references.map((item) => (
            <a href={item.href} target="_blank" rel="noopener noreferrer" title={item.alt}>
                <Icon name={item.name} class="icon" />
            </a>
        ))
    }
</div>

<style>
    div {
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    a, .icon {
        filter: var(--filter-hover);
        width: auto;
        height: 24px;
        color: var(--color-text);
    
        &:hover {
            translate: 0 -2px;
            filter: contrast(100%);
            transition: all 0.2s;
        }
    }
</style>
