---
import { Icon } from "astro-icon/components";
import { config } from "src/site-config";

const references = config.footer.social ?? []

const { class: className = "" } = Astro.props;
---

<div class:list={className}>
    {
        references.map((item) => (
            <a href={item.url} target="_blank" rel="noopener noreferrer" title={item.alt}>
                <Icon name={item.icon} class="icon" />
            </a>
        ))
    }
</div>

<style>
    div {
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    a, .icon {
        filter: var(--filter-hover);
        width: auto;
        height: 24px;
        color: var(--color-text);
    
        &:hover {
            translate: 0 -2px;
            filter: contrast(100%);
            transition: all 0.2s;
        }
    }
</style>
