---
import HeaderLink from "./HeaderLink.astro";
import DarkModeSwitch from "./DarkModeSwitch.svelte";
---
<nav>
    <div class="links">
        <HeaderLink href="/">Projects</HeaderLink>
        <HeaderLink href="/blog">Blog</HeaderLink>
        <HeaderLink href="/dash">Experimental</HeaderLink>
    </div>
    <DarkModeSwitch class="DarkModeSwitch" client:load />
</nav>

<style>
    h1 {
        text-wrap: nowrap;
    }
    nav {
        display: flex;
        position: sticky;
        top: 0;
        flex-wrap: wrap-reverse;
        justify-content: space-between;
        align-items: center;
        z-index: 999;
        transition: all 0.3s ease-in-out;
        box-shadow: 0px 1px var(--color-shadow);
        background: var(--color-pastel-header);
        padding: 0 max(36px, 15vw);
        a {
            grid-column: 2;
            margin: 0;
            color: var(--color-text);
            text-decoration: none;
    
            h1 {
                margin: 0.5rem 0;
                font-family: var(--font-title);
            }
    
            &:hover {
                translate: 0 -2px;
                filter: var(--filter-hover)
                border-bottom-color: contrast-color(var(--color-pastel-header));
            }
        }
    }
    .links {
        display: flex;
        justify-content: end;
        align-items: center;
        gap: 1em;
        font-family: var(--font-heading);
        
        a {
            border-bottom: 5px solid transparent;
            padding: 1.1em 0.5em;
        }
        a.active {
            border-bottom-color: var(--color-text);
        }
        a:hover {
            border-bottom-color: contrast-color(var(--color-pastel-header));
            color: contrast-color(var(--color-pastel-header));
        }
    }
    @media (max-width: 600px) {
        nav {
            flex-wrap: nowrap;
            padding: 0 1rem;
        }
        nav :is(h1, h2, h3, h4, h5, h6) {
            display: none;
        }
    }
</style>
