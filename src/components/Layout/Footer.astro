---
import References from "./References.astro";
import { config } from "src/site-config";
const copyright = config.footer.copyright
---

<footer>
    <span>
        {copyright}
    </span>
    <References class:list={"ref"} />
</footer>
<style>
    footer {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        margin-top: auto;
        padding: 2em 1em;
        color: rgb(var(--gray));
        text-align: center;
    }

    :global(.ref) {
        justify-self: center;
        margin: 0 auto;
        padding: 1em 0;
    }
</style>
