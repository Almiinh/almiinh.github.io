---
import { Icon } from "node_modules/astro-icon/components";
---

<button id="back-to-top" type="button" aria-label="Back to top" title="Back to top">
    <Icon name="hugeicons:arrow-up-03" />
</button>

<script>
    // Show a floating "back to top" button after scrolling down a page,
    // smooth-scroll to the top on click.
    const btn = document.getElementById("back-to-top");
    const onScroll = () => {
        if (!btn) return;
        const show = window.scrollY > 480;
        btn.classList.toggle("show", show);
        btn.setAttribute("aria-hidden", String(!show));
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
    btn?.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
    });
</script>

<style>
    #back-to-top {
        display: inline-flex;
        position: fixed;
        right: 1.25rem;
        bottom: 1.25rem;
        justify-content: center;
        align-items: center;
        transform: translateY(8px);
        visibility: hidden;
        opacity: 0;
        z-index: 40;
        backdrop-filter: blur(8px);
        transition:
            opacity 0.25s ease,
            transform 0.25s ease,
            visibility 0.25s,
            color 0.2s ease,
            background-color 0.2s ease;
        cursor: pointer;
        box-shadow: 0 4px 16px hsl(from var(--ink) h s l / 0.14);
        border: 1px solid hsl(from var(--line) h s l / 1);
        border-radius: 9999px;
        background: hsl(from var(--card) h s l / 0.92);
        width: 2.75rem;
        height: 2.75rem;
        pointer-events: none;
        color: hsl(from var(--ink-soft) h s l / 1);
    }
    #back-to-top.show {
        transform: translateY(0);
        visibility: visible;
        opacity: 1;
        pointer-events: auto;
    }
    #back-to-top:hover {
        background: hsl(from var(--wash) h s l / 1);
        color: hsl(from var(--accent) h s l / 1);
    }
</style>
