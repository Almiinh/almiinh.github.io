---
interface Props {
    /**
     * CSS selector for the article container to scan for headings.
     * Defaults to '.blog-content'.
     */
    contentSelector?: string;
    /**
     * Which heading levels to include, e.g. ['h2', 'h3'].
     * Defaults to h1–h6.
     */
    headingLevels?: string[];
    /** Optional title shown above the outline list. */
    title?: string;
}

const {
    contentSelector = ".blog-content",
    headingLevels = ["h1", "h2", "h3", "h4", "h5", "h6"],
    title = "On this page",
} = Astro.props;

// Serialize props so the client script can read them.
const config = JSON.stringify({ contentSelector, headingLevels });
---

<nav class="toc" aria-label="Table of contents" data-toc-config={config}>
    {title && <h3 class="toc-title">{title}</h3>}
    <ol class="toc-list" role="list"></ol>
</nav>

<script>
    function initTOC(nav: HTMLElement) {
        const raw = nav.dataset.tocConfig ?? "{}";
        const { contentSelector, headingLevels } = JSON.parse(raw) as {
            contentSelector: string;
            headingLevels: string[];
        };

        const article = document.querySelector(contentSelector);
        const list = nav.querySelector(".toc-list") as HTMLOListElement;

        if (!article || !list) return;

        const selector = headingLevels.join(", ");
        const headings = article.querySelectorAll<HTMLHeadingElement>(selector);

        if (headings.length === 0) return;

        headings.forEach((heading, index) => {
            // Ensure every heading has a stable anchor id.
            if (!heading.id) {
                heading.id =
                    heading.textContent
                        ?.trim()
                        .toLowerCase()
                        .replace(/[^\w\s-]/g, "")
                        .replace(/\s+/g, "-") ?? `heading-${index}`;
            }

            const level = parseInt(heading.tagName[1], 10);

            const li = document.createElement("li");
            li.className = `toc-item toc-level-${level}`;
            li.style.setProperty("--depth", String(level - 1));

            const a = document.createElement("a");
            a.href = `#${heading.id}`;
            a.textContent = heading.textContent ?? "";
            a.className = "toc-link";

            li.appendChild(a);
            list.appendChild(li);
        });

        // Highlight the active heading while scrolling.
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    const id = entry.target.id;
                    const link = list.querySelector<HTMLAnchorElement>(`a[href="#${id}"]`);
                    if (link) {
                        link.classList.toggle("toc-link--active", entry.isIntersecting);
                    }
                });
            },
            { rootMargin: "0px 0px -80% 0px", threshold: 0 },
        );

        headings.forEach((h) => observer.observe(h));
    }

    // Run after the DOM is ready; also re-run after Astro view transitions.
    document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll<HTMLElement>("[data-toc-config]").forEach(initTOC);
    });

    document.addEventListener("astro:page-load", () => {
        document.querySelectorAll<HTMLElement>("[data-toc-config]").forEach(initTOC);
    });
</script>

<style>
    .toc h3 {
        margin: 0 0 1rem 0;
        color: var(--color-text-secondary);
        font-weight: 600;
        font-size: 0.875rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }
    .toc {
        --toc-accent: #4f46e5;
        --toc-text: #374151;
        --toc-muted: #9ca3af;
        --toc-bg: #f9fafb;
        --toc-border: #e5e7eb;
        --toc-indent: 1rem;
        /* border: 1px solid var(--toc-border); */
        border-radius: 0.5rem;

        background: var(--color-bg);
        padding: 1rem;
        font-size: 0.875rem;
    }

    .toc-title {
        margin: 0 0 0.75rem;
        color: var(--toc-text);
        font-weight: 600;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .toc-list {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .toc-item {
        padding-left: calc(var(--depth, 0) * var(--toc-indent));
    }

    .toc-link {
        display: block;
        transition:
            color 0.15s ease,
            border-color 0.15s ease;
        border-left: 2px solid transparent;
        padding: 0.2rem 0;
        padding-left: 0.5rem;
        color: var(--toc-muted);
        line-height: 1.4;
        text-decoration: none;
    }

    .toc-link:hover {
        color: var(--toc-accent);
    }

    .toc-link--active {
        border-left-color: var(--toc-accent);
        color: var(--toc-accent);
        font-weight: 500;
    }
</style>
