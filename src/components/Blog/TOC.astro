---
import type { MarkdownHeading } from 'astro'

interface Props {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 4)
---

{toc.length > 0 && (
  <>
    {/* Desktop only: sticky aside, placed in the right column of the article grid */}
    <aside class="toc">
      <h2 class="">Contents</h2>
      <ul class="mt-3 flex flex-col gap-0.5 border-s border-line ps-4">
        {toc.map((h) => (
          <li style={`padding-inline-start: ${(h.depth - 2) * 0.85}rem`}>
            <a
              href={`#${h.slug}`}
              class="toc-link rounded-md py-1 text-[13px] leading-snug text-ink-soft transition-colors duration-200 hover:text-accent"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </aside>
  </>
)}

<style>
  .toc {
    position: sticky;
    top: 6rem;
    max-height: max-height: calc(100dvh - 8rem); /* 128px */
    align-self: flex-start;
    overflow-y: auto;
    scrollbar-color: hsl(var(--line) / 0.5) hsl(var(--card) / 0.5);
    scrollbar-width: thin;
    @media (pointer: coarse) {
      display: none;
    }

    h2 {

    }

    ul {
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.125rem;
      border-left: 1px solid hsl(var(--line) / 0.5);
      
      li {
        list-style: none;
        color: var(--color-text-secondary)
      }
    }

    a {
      display: block;
      rounded: 0.375rem;
      padding: 0.15rem 0.75rem;
      font-size: 0.8125rem;
      color: hsl(var(--ink-soft) / 1);
      transition: color 0.2s ease-in-out;
      text-decoration: none;
    }

    a:hover {
      color: hsl(var(--color-accent) / 1);
      filter: var(--filter-hover);
      background-color: var(--color-bg-secondary);
    }

    a.active {
      color: hsl(var(--color-accent) / 1);
      font-weight: 600;
      font-size: 1rem;
    }
  }
</style>

<script>
  const links = Array.from(document.querySelectorAll('.toc-link'))
  if (links.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)
        if (!visible.length) return
        const id = visible[0].target.id
        links.forEach((link) =>
          link.classList.toggle('active', link.getAttribute('href') === `#${id}`)
        )
      },
      { rootMargin: '-15% 0px -70% 0px' }
    )
    links.forEach((link) => {
      const el = document.getElementById(link.getAttribute('href')!.slice(1))
      if (el) observer.observe(el)
    })
  }
</script>
