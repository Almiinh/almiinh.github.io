---
const { tags = [{ name: "" }] } = Astro.props;

interface Props {
    tags: Tag[];
}

interface Tag {
    name: string;
    backgroundColor?: string;
    color?: string;
}
---

<div class="tags">
    {
        tags.map((tag) => (
            <span class="tag" style={`--tag-bg: ${tag.backgroundColor ?? "rgba(255, 127, 80, 0.5)"};`}>
                {tag.name}
            </span>
        ))
    }
</div>

<style>
    .tags {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.2rem;
        width: fit-content;
    }

    .tag {
        --tag-bg-solid: color-mix(in srgb, var(--tag-bg, rgba(255, 127, 80, 0.5)) 100%, white 0%);
        border-radius: 10px;
        background-color: var(--tag-bg);
        padding: 0 0.4rem;
        min-width: 2rem;
        height: fit-content;
        color: contrast-color(color-mix(in srgb, var(--tag-bg, rgba(255, 127, 80, 0.5)) 100%, black 50%));
        font-size: 0.7rem;
        text-align: center;
        text-wrap: nowrap;
    }
</style>
