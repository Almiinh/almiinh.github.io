---
interface Props {
    items: any[];
    cardComponent?: any;
    itemProp?: string;
    autoSlide?: boolean;
    autoSlideInterval?: number;
    showIndicators?: boolean;
}

const {
    items = [],
    cardComponent: CardComponent,
    itemProp = "item",
    autoSlide = false,
    autoSlideInterval = 5000,
    showIndicators = true,
} = Astro.props;
---

<div class="carousel">
    <div class="carousel-track">
        <div class="carousel-slides">
            {
                items.map((item, index) => {
                    const props = { [itemProp]: item };
                    return (
                        <div class="carousel-slide" data-index={index}>
                            {CardComponent ? <CardComponent {...props} /> : item}
                        </div>
                    );
                })
            }
        </div>
    </div>
    <div class="carousel-controls">
        <button class="carousel-button prev-button" aria-label="Previous slide" onclick="prevSlide()">
            <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"></path>
            </svg>
        </button>

        {
            showIndicators && (
                <div class="carousel-indicators">
                    {items.map((_, index) => (
                        <button
                            class="indicator-dot"
                            data-index={index}
                            aria-label={`Go to slide ${index + 1}`}
                            aria-current={index === 0 ? "true" : "false"}
                            onclick={`setCurrentIndex(${index})`}
                        />
                    ))}
                </div>
            )
        }

        <button class="carousel-button next-button" aria-label="Next slide" onclick="nextSlide()">
            <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M8.59 16.59L10 18l6-6-6-6-1.41 1.41L13.17 12z"></path>
            </svg>
        </button>
    </div>
</div>

<script define:vars={{ autoSlide, autoSlideInterval, itemCount: items.length }}>
    const carousel = document.querySelector(".carousel");
    const indicatorDots = document.querySelectorAll(".indicator-dot");

    let currentIndex = 0;
    let autoSlideTimer = null;

    window.setCurrentIndex = function (index) {
        currentIndex = index % itemCount;
        carousel.style.setProperty("--carousel-index", currentIndex);

        // Update indicator dots
        indicatorDots.forEach((dot, idx) => {
            dot.classList.toggle("active", idx === currentIndex);
            dot.setAttribute("aria-current", idx === currentIndex ? "true" : "false");
        });

        resetAutoSlide();
    };

    window.nextSlide = function () {
        setCurrentIndex(currentIndex + 1);
    };

    window.prevSlide = function () {
        setCurrentIndex(currentIndex - 1 + itemCount);
    };

    function startAutoSlide() {
        if (autoSlide && itemCount > 1) {
            autoSlideTimer = setInterval(nextSlide, autoSlideInterval);
        }
    }

    function resetAutoSlide() {
        if (autoSlideTimer) {
            clearInterval(autoSlideTimer);
            startAutoSlide();
        }
    }

    function handleKeydown(e) {
        if (e.key === "ArrowLeft") {
            window.prevSlide();
        } else if (e.key === "ArrowRight") {
            window.nextSlide();
        }
    }

    carousel.addEventListener("keydown", handleKeydown);

    let touchStartX = 0;
    let touchEndX = 0;
    const SWIPE_THRESHOLD = 50;

    carousel.addEventListener(
        "touchstart",
        (e) => {
            touchStartX = e.changedTouches[0].screenX;
        },
        { passive: true },
    );

    carousel.addEventListener(
        "touchend",
        (e) => {
            touchEndX = e.changedTouches[0].screenX;
            const delta = touchStartX - touchEndX;
            if (Math.abs(delta) > SWIPE_THRESHOLD) {
                delta > 0 ? window.nextSlide() : window.prevSlide();
            }
        },
        { passive: true },
    );

    // Initialize
    setCurrentIndex(0);
    startAutoSlide();
</script>

<style>
    .carousel {
        width: 100%;
        max-width: 100%;
        --carousel-index: 0;
        --slide-width: 35%;

        .carousel-track {
            flex: 1;
            min-height: auto;
            overflow: hidden;

            .carousel-slides {
                display: flex;
                transform: translateX(calc(var(--carousel-index) * -1 * var(--slide-width)));
                transition: transform 0.3s ease-in-out;
            }

            .carousel-slide {
                display: flex;
                flex: 0 0 var(--slide-width);
                align-items: stretch;
                padding: 0 0.5rem;
            }

            .carousel-slide :global(img) {
                width: 100%;
                height: auto;
                max-height: 10rem;
                object-fit: cover;
            }
        }

        .carousel-controls {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 1rem;
            margin-top: 1rem;
            .carousel-indicators {
                display: flex;
                justify-content: center;
                gap: 0.5rem;
                /* remove the margin-top here since it's now inside the flex row */
                margin-top: 0;
            }

            .carousel-button {
                display: flex;
                flex-shrink: 0;
                justify-content: center;
                align-items: center;
                transition: all 0.2s ease-in-out;
                cursor: pointer;
                margin: 0.5rem;
                border: 1px solid var(--color-shadow);
                border-radius: 50%;
                background-color: var(--color-bg);
                padding: 0;
                width: 2.5rem;
                height: 2.5rem;
                color: var(--color-text);

                &:hover {
                    transform: scale(1.1);
                    background-color: var(--color-text);
                    color: var(--color-bg);
                }

                &:active {
                    transform: scale(0.95);
                }

                svg {
                    width: 1.25rem;
                    height: 1.25rem;
                }
            }

            .indicator-dot {
                transition: all 0.2s ease-in-out;
                cursor: pointer;
                border: 2px solid var(--color-text);
                border-radius: 50%;
                background-color: transparent;
                padding: 0;
                width: 0.75rem;
                height: 0.75rem;

                &:hover {
                    transform: scale(1.2);
                    background-color: var(--color-text);
                }

                &.active {
                    background-color: var(--color-text);
                }
            }
        }
    }
</style>
