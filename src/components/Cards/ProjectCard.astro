---
import Tags from "../Tags.astro";
import Card from "./Card.astro";
import type { Project } from "$/assets/index/projectsData";
import { Icon } from "astro-icon/components";

type Props = {
    project: Project;
};

const { project } = Astro.props;
---

<Card href={project.href} target="_blank" title="Click to open the project page." class="project-card">
    <div class="content">
        {project.title && <h4 class="title">{project.title}</h4>}
        {project.image && <img src={project.image} alt={project.title} />}
        {project.desc && <div class="desc">{project.desc}</div>}
    </div>
    <div class="bar">
        <Tags tags={project.tags} />
        {
            project.href && (
                <Icon name="hugeicons:external-link" class="icon" />
            )
        }
    </div>
</Card>

<style>
    .project-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .content {
        display: flex;
        flex-direction: column;
    }
    img {
        margin: 1em 0;
        object-fit: cover;
    }
    .title {
        margin: 0;
        color: var(--color-text);
        font-weight: bolder;
        font-size: large;
    }
    .desc {
        color: var(--color-text-secondary);
        font-size: small;
    }
    .bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 1rem 0 0 0;
        width: 100%;
        color: var(--color-text);
    }
    .bar .icon {
        flex-shrink: 0;
        width: 1.5rem;
        height: 1.5rem;
    }
</style>
