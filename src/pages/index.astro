---
import Layout from "$/layouts/Layout.astro";
import { Image } from "astro:assets";
import moustillon from "$/assets/index/moustillon-content.jpg";
import { projects, featuredProjects } from "$/assets/index/projectsData.js";
import ProjectCard from "$/components/Cards/ProjectCard.astro";
import Card from "$/components/Cards/Card.astro";
import Tags from "$/components/Tags.astro";
import References from "$/components/Layout/References.astro";
import Carousel from "$/components/Carousel.astro";
import "$/assets/styles/details.css";
---

<Layout title="Minh-Hoang HUYNH">
    <section id="title">
        <div class="me">
            <img class="photo" src={moustillon.src} alt="Moustillon!" title="Moustillon!"/>
            <div class="me-name">
                <hgroup>
                    <h1>Minh-Hoang HUYNH</h1>
                    <p>V&V Engineer @ Alstom, Saint-Ouen, FR</p>
                </hgroup>

                <References />
            </div>
        </div>
    </section>
    <section id="featured">
        <details open>
            <summary>
                <h2>Featured</h2>
            </summary>
            <Carousel
                items={featuredProjects}
                cardComponent={ProjectCard}
                itemProp="project"
                autoSlide={true}
                showIndicators={true}
            />
        </details>
    </section>
    {
        projects.map(({ heading, id, projects }) => (
            <section id={id}>
                <details>
                    <summary>
                        <h2>{heading}</h2>
                    </summary>
                    <div class="links">
                        {projects.map((project) => (
                            <ProjectCard {project} />
                        ))}
                    </div>
                </details>
            </section>
        ))
    }
    <br />
</Layout>

<style>
    section#title {
        display: flex;
        gap: 1rem;
        @media screen and (max-width: 700px) {
            flex-direction: column;
        }
        
        .me {
            display: flex;
            gap: 2rem;
            padding: 1rem;
            width: 100%;

            @media screen and (max-width: 700px) {
                flex-direction: column;
                gap: 0;
            }
            h1 {
                margin: 0;
                padding: 0;
                font-size: 2.75rem;
                font-family: var(--font-title);
                @media screen and (max-width: 700px) {
                    font-size: 2.75rem;
                    text-align: center
                }
            }

            p {
                margin-bottom: 0.5rem;
                font-style: italic;
                font-size: small;
            }
        }
        .photo {
            display: flex;
            flex-direction: column;
            align-self: center;
            border-radius: 100%;
            max-width: 5rem;
            max-height: 5rem;
        }
        .me-name {
            display: flex;
            flex-direction: column;
            justify-content: center;
            @media screen and (max-width: 700px) {
                align-items: center;
            }
        }
        ul {
            align-self: center;
            margin: 1rem;
            padding-left: 0;
            font-size: smaller;
            list-style-type: none;
    
            li:last-child {
                border-left-style: dashed;
            }
            li {
                top: 0.2rem;
                margin: 0 0 0 1rem;
                border-left: 1px solid rgba(255, 127, 80, 0.5);
        
                padding-left: 0.5rem;
                font-style: italic;
                font-size: smaller;
        
                @media screen (min-width: 800px) {
                    display: flex;
                    align-items: center;
                    gap: 1rem;
                }
            }
        }
    }
    section#featured {
        margin-top: 2rem;
    }
    .links {
        column-gap: 1rem;
        column-count: 1;

        @media screen and (min-width: 700px) {
            column-count: 2;
        }
        @media screen and (min-width: 1100px) {
            column-count: 3;
        }
        @media screen and (min-width: 1700px) {
            column-count: 4;
        }
        @media screen and (min-width: 2000px) {
            column-count: 5;
        }
        @media screen and (min-width: 2300px) {
            column-count: 6;
        }
    }

</style>
