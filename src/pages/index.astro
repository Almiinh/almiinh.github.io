---
import Layout from "$layouts/Layout.astro";
import { Image } from "astro:assets";
import moustillon from "$assets/index/moustillon-content.jpg";
import { projects, featuredProjects } from "$assets/index/projectsData.js";
import ProjectCard from "$components/Cards/ProjectCard.astro";
import Card from "$components/Cards/Card.astro";
import Tags from "$components/Tags.astro";
import References from "$layouts/components/References.astro";
import Carousel from "$components/Carousel.astro";
import "$styles/details.css";
---

<Layout title="Minh-Hoang HUYNH">
    <section id="title">
        <Card class="me">
            <img class="photo" src={moustillon.src} alt="Moustillon!" title="Moustillon!"/>
            <div class="me-name">
                <h1>Minh-Hoang HUYNH</h1>
                <References />
            </div>
        </Card>
        <Card>
            <ul>
                <Tags tags={[{ name: "Jul 2025 — Currently" }]} />
                <li>
                    <br />
                    System V&V Engineer<br />
                    @ Alstom, Saint-Ouen, FR<br /><br />
                </li>
                <Tags tags={[{ name: "Aug 2024 — Jan 2025" }]} />
                <li>
                    <br />
                    LLM Agent Developer Intern <br />
                    @ Thales Research & Technologies, Palaiseau, FR
                    <br /><br />
                </li>
                <Tags tags={[{ name: "Sept 2021 — Jan 2025" }]} />
                <li>
                    <br />CS & Engineering Student<br />
                    @ Mines Saint-Étienne, FR<br /><br />
                </li>
                <Tags tags={[{ name: "Sept 2019 — Jul 2021" }]} />
                <li>
                    <br />Student in Maths-Physics Preparatory Classes for French Grandes Écoles (MPSI-MP)<br
                    />
                    @ Lycée Pasteur, Neuilly-sur-Seine, FR<br /><br />
                </li>
            </ul>
        </Card>
    </section>
    <section id="featured">
        <summary>
            <h2>Featured</h2>
        </summary>
        <Carousel
            items={featuredProjects}
            cardComponent={ProjectCard}
            itemProp="project"
            autoSlide={true}
            showIndicators={true}
        />
    </section>
    {
        projects.map(({ heading, id, projects }) => (
            <section id={id}>
                <details>
                    <summary>
                        <h2>{heading}</h2>
                    </summary>
                    <div class="links">
                        {projects.map((project) => (
                            <ProjectCard {project} />
                        ))}
                    </div>
                </details>
            </section>
        ))
    }
    <br />
</Layout>

<style>
    section#title {
        display: flex;
        gap: 1rem;
        @media screen and (max-width: 700px) {
            flex-direction: column;
        }
        
        .me {
            display: flex;
            gap: 2rem;
            padding: 1rem;
            @media screen and (max-width: 700px) {
                flex-direction: column;
                gap: 0;
            }
            h1 {
                font-size: 2.75rem;
                font-family: var(--font-title);
                @media screen and (max-width: 700px) {
                    margin: 0;
                    font-size: 2.75rem;
                    text-align: center
                }
            }
        }
        .photo {
            display: flex;
            flex-direction: column;
            align-self: center;
            border-radius: 100%;
            max-width: 10rem;
            max-height: 10rem;
        }
        .me-name {
            display: flex;
            flex-direction: column;
            justify-content: center;
            @media screen and (max-width: 700px) {
                align-items: center;
            }
        }
        ul {
            align-self: center;
            margin: 1rem;
            padding-left: 0;
            font-size: smaller;
            list-style-type: none;
    
            li:last-child {
                border-left-style: dashed;
            }
            li {
                top: 0.2rem;
                margin: 0 0 0 1rem;
                border-left: 1px solid rgba(255, 127, 80, 0.5);
        
                padding-left: 0.5rem;
                font-style: italic;
                font-size: smaller;
        
                @media screen (min-width: 800px) {
                    display: flex;
                    align-items: center;
                    gap: 1rem;
                }
            }
        }
    }
    section#featured {
        margin-top: 2rem;
    }
    .links {
        column-gap: 1rem;
        column-count: 1;

        @media screen and (min-width: 700px) {
            column-count: 2;
        }
        @media screen and (min-width: 1100px) {
            column-count: 3;
        }
        @media screen and (min-width: 1700px) {
            column-count: 4;
        }
        @media screen and (min-width: 2000px) {
            column-count: 5;
        }
        @media screen and (min-width: 2300px) {
            column-count: 6;
        }
    }

</style>
