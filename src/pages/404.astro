---
import Layout from '$/layouts/Layout.astro'
import { Icon } from "astro-icon/components";
---

<Layout title="Page not found" noindex>
  <div class="container">
    <p class="error-code">404</p>
    <p>Oops! The page you are looking for does not exist.</p>
    <a href="/" data-astro-prefetch>
        <button>
            <Icon name="hugeicons:home-05" class="size-4" aria-hidden="true" />
            Back to home
        </button>
    </a>
  </div>
</Layout>


<style>
    .container {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 1.5rem;
        padding: 5rem 0;
        text-align: center;
    }

    .error-code {
        color: var(--color-accent);
        font-weight: bold;
        font-size: 5rem;
        font-family: var(--font-heading);
    }

    a {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
    }

    button {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        break-inside: avoid;
        transition: all 0.2s ease-in-out;
        box-shadow: 3px 3px 1px var(--color-shadow);
        border: 1px solid var(--color-shadow);
        border-radius: 5rem;
        background-color: var(--color-bg);
        padding: 0.5rem 1rem;
        text-decoration: none;
    }
    button:hover {
        transform: translateY(2px);
        filter: var(--filter-hover);
        cursor: pointer;
        box-shadow: 1px 1px 1px var(--color-shadow);
    }
</style>
