---
import Header from "$/layouts/components/Header.astro";
import Footer from "$/layouts/components/Footer.astro";

const { title, class: className, largeScreenMargin = "15vw", smallScreenMargin = "5vw" } = Astro.props;

---

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <link rel="stylesheet" href="/index/global.css" />
    </head>
    <body>
        <Header />
        <main class={className}>
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style define:vars={{ largeScreenMargin, smallScreenMargin }}>
    body {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        margin: 0;
        @media (pointer: coarse) {
            width: fit-content;
        }
        height: 100%;
        min-height: 100vh;
    }
    main {
        margin: 5vh max(var(--largeScreenMargin), 36px);
        @media (max-width: 1000px) {
            margin: 5vh max(var(--smallScreenMargin), 36px);
            width: fit-content;
        }
        /* @media screen and (max-width: 800px) {
            margin: 5vh max(var(--smallScreenMargin), 36px);
        } */
    }
    :global(*:is(h1, h2, h3, h4, h5, h6)) {
        font-family: var(--font-heading);
    }
</style>
