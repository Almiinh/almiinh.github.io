---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import FormattedDate from "$components/FormattedDate.astro";
import Layout from "$layouts/Layout.astro";
import "$styles/markdown.css";
// import 'rehype-callouts/theme/obsidian'
// import 'rehype-callouts/theme/vitepress'
// import 'rehype-callouts/theme/docusaurus'
import Outline from "$components/Blog/Outline.svelte";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage, heroSize, foldHeadings } = Astro.props;
const foldAll = foldHeadings ?? false;
---

<script>
    document.querySelectorAll("[data-callout]").forEach((callout) => {
        const emoji = callout.getAttribute("data-callout-type");
        const title = callout.querySelector("[data-callout-title]");
        if (emoji === title?.textContent?.trim()) title.remove();
    });
    Array.from(document.querySelectorAll(".blog-body :is(h2, h3, h4, h5, h6):not(.toc-title)")).forEach(
        (heading) => {
            const level = parseInt(heading.tagName[1], 10);
            const parent = heading.parentNode;
            if (!parent) return;
            const foldAll =
                document.querySelector("[data-fold-all]")?.getAttribute("data-fold-all") === "true";

            const details = document.createElement("details");
            details.open = !foldAll;
            const summary = document.createElement("summary");

            parent.insertBefore(details, heading);
            details.appendChild(summary);
            summary.appendChild(heading);

            let next = details.nextSibling;
            while (next) {
                const isHeading = next instanceof Element && /^H[1-6]$/.test(next.tagName);
                const nextLevel = isHeading ? parseInt((next as Element).tagName[1], 10) : Infinity;

                if (isHeading && nextLevel <= level) break;

                const toMove = next;
                next = next.nextSibling;
                details.appendChild(toMove);
            }
        },
    );
</script>

<Layout title={title} largeScreenMargin="2.5vw">
    <div class="blog-container">
        <div></div>
        <article class="blog-content" data-fold-all={foldAll}>
            <div class="title">
                <div class="hero-image small">
                    {heroImage && heroSize === "small" && <Image src={heroImage} alt="" />}
                </div>
                <h1>{title}</h1>
                <p>{description}</p>
                <div class="date">
                    <FormattedDate date={pubDate} />
                    {
                        updatedDate && (
                            <div class="last-updated-on">
                                Last updated on <FormattedDate date={updatedDate} />
                            </div>
                        )
                    }
                </div>
                <hr />
            </div>
            <div class="hero-image">
                {heroImage && heroSize === "large" && <Image src={heroImage} alt="" />}
            </div>
            <div class="blog-body">
                <slot />
            </div>
        </article>
        <aside class="outline-sidebar">
            <Outline client:load />
        </aside>
    </div>
</Layout>

<style>
    main {
        margin: 0;
        max-width: 100%;
    }
    .blog-container {
        display: grid;
        grid-template-columns: 9vw 1fr 19vw;
        gap: 1vw;
        max-width: 100%;
    }
    .hero-image img {
        display: block;
        margin: 0 auto;
        box-shadow: var(--box-shadow);
        border-radius: 12px;
        height: auto;
    }
    .hero-image.small img {
        margin: 0.5rem 1rem 0.5rem 0;
        border-radius: 12px;
        border-radius: 8px;
        width: auto;
        max-width: 10rem;
        height: auto;
        max-height: 6rem;
        object-fit: cover;
    }
    .title {
        margin-bottom: 1em;
    }
    .title h1 {
        font: bold var(--size-title) var(--font-title);
    }
    .title p {
        color: var(--color-text-secondary);
    }
    .date {
        margin-bottom: 0.5em;
        color: rgb(var(--gray));
    }
    .last-updated-on {
        font-style: italic;
    }
    /* Outline Sidebar Styles */
    .outline-sidebar {
        position: sticky;
        top: 6rem;
        height: fit-content;
        overflow: scroll;
    }
    @media (max-width: 1024px) {
        .blog-container {
            grid-template-columns: 1fr;
        }
        .outline-sidebar {
            position: static;
        }
    }
</style>
